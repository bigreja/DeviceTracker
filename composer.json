{
  "name": "bigreja/device-tracker",
  "description": "Device Tracker extension for Flarum",
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Bruno Igreja"
    }
  ],
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0",
    "dflydev/fig-cookies": "^3.0",
    "ramsey/uuid": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "Bigreja\\DeviceTracker\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Device Tracker",
      "icon": {
        "name": "fas fa-shield-alt",
        "backgroundColor": "#e74c3c",
        "color": "#fff"
      },
      "category": "moderation",
      "database-support": [
        "mysql",
        "pgsql",
        "sqlite"
      ]
    }
  }
}